{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "biome.json"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"format": {
			"inputs": ["$TURBO_DEFAULT$", "biome.json"]
		},
		"test": {
			"dependsOn": ["build"],
			"inputs": ["src/**", "test/**", "vitest.config.ts"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
