{
  "name": "kirika-js",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@kirika-js/api",
    "test": "turbo run test",
    "report": "turbo run test && turbo run report",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "check": "pnpm lint && pnpm check-types && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
