{
  "name": "kirika-js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@kirika-js/api",
    "dev:studio": "turbo run dev --filter=@kirika-js/studio",
    "test": "turbo run test",
    "report": "turbo run test && turbo run report",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "check": "pnpm lint && pnpm check-types && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^3.0.1",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.8",
    "unrun": "^0.3.1"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
