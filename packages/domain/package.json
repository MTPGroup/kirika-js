{
  "name": "@kirika-js/domain",
  "version": "0.1.0",
  "private": true,
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "description": "",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@kirika-js/typescript-config": "workspace:*",
    "@kirika-js/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./character": {
      "import": "./dist/character.mjs",
      "require": "./dist/character.cjs"
    },
    "./conversation": {
      "import": "./dist/conversation.mjs",
      "require": "./dist/conversation.cjs"
    },
    "./lorebook": {
      "import": "./dist/lorebook.mjs",
      "require": "./dist/lorebook.cjs"
    },
    "./shared": {
      "import": "./dist/shared.mjs",
      "require": "./dist/shared.cjs"
    },
    "./package.json": "./package.json"
  }
}
