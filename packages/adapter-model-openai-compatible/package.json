{
  "name": "@kirika-js/adapter-model-openai-compatible",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest -w"
  },
  "dependencies": {
    "@kirika-js/chat-engine": "workspace:*",
    "@kirika-js/domain": "workspace:*",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@kirika-js/typescript-config": "workspace:*",
    "@kirika-js/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
