{
  "name": "@kirika-js/chat-engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@kirika-js/domain": "workspace:*"
  },
  "devDependencies": {
    "@kirika-js/typescript-config": "workspace:*",
    "@kirika-js/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  }
}
