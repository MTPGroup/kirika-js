    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "1.7.0-beta.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "handlebars": "^4.7.9",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "smol-toml": "^1.8.0",
    "uuid": "^14.0.1",
    "zod": "catalog:",
    "zod-config": "^1.4.0"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@dbml/cli": "^10.1.1",
    "@kirika-js/typescript-config": "workspace:*",
    "@kirika-js/vitest-config": "workspace:*",
