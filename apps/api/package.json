    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "1.0.0-rc.4",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
