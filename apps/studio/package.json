{
  "name": "@kirika-js/studio",
  "version": "0.1.0",
  "description": "面向角色、世界书的创作工作台",
  "private": true,
  "main": "./out/main/index.js",
  "author": "hanasak1 <hanasakayui2022@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/MTPGroup/kirika-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/MTPGroup/kirika-js.git"
  },
  "desktopName": "Kirika Studio",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:linux": "pnpm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@kirika-js/adapter-model-openai-compatible": "workspace:*",
    "@kirika-js/adapter-persistence-sqlite": "workspace:*",
    "@kirika-js/adapter-storage-filesystem": "workspace:*",
    "@kirika-js/core": "workspace:*",
    "@lucide/vue": "^1.33.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vitest": "catalog:",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
